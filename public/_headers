# Cloudflare Pages reads this file from the repo root.
# Rules are matched in order and later matches win, so the general rule comes
# first and the more specific paths override it below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # No 'unsafe-inline' anywhere: injected markup cannot run script or restyle
  # the page, which is the whole point of having a policy. Keeping it that way
  # is a build-config invariant, not a habit —
  #   style-src: astro.config.mjs sets build.inlineStylesheets:'never', and no
  #     .astro file carries a style="…" attribute (the classes are in
  #     global.css instead).
  #   script-src: the same config sets vite.build.assetsInlineLimit:0, so every
  #     <script> is emitted as a hashed file under /_astro rather than inlined.
  # The one inline block left is <script type="application/ld+json">, and CSP
  # does not apply to it: a script element whose type is not a JavaScript MIME
  # type is a data block, and HTML's "prepare the script element" returns before
  # it ever reaches the CSP check. Nothing executes, so nothing is blocked.
  #
  # The policy also pins every external origin we allow.
  # static.cloudflareinsights.com is the Cloudflare Web Analytics beacon.
  # formspree.io needs both connect-src (the contact form's fetch submit) and
  # form-action (the no-JS fallback, which posts the form natively).
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://formspree.io; form-action 'self' https://formspree.io; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Astro fingerprints everything it emits here — the stylesheet, optimized
# images, page scripts — with a content hash in the filename, so a given URL
# never changes meaning. Cache it forever; a new build ships new filenames.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

# One static .ics file per dated event (src/pages/events/[id].ics.js), linked
# from each EventCard's "add to calendar" link. Content-Type is pinned
# explicitly rather than left to Cloudflare's own extension-based guess,
# because this one has to be exactly right: iOS Safari's native "Add to
# Calendar" sheet only appears when it navigates to a URL whose response is
# text/calendar — anything else (including the data: URI this used to be)
# falls back to a raw-text download instead. No Content-Disposition here on
# purpose: "attachment" would force a download on every platform, which is
# the desktop behaviour this is precisely trying to avoid recreating on iOS.
/events/*.ics
  Content-Type: text/calendar; charset=utf-8

# Font filenames encode family, weight, style and subset, so they only change
# when the font itself is regenerated. Safe to hold on to.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, immutable

# The unoptimized originals, mirrored from src/images by scripts/mirror-media.mjs
# purely so /admin can show a thumbnail of each entry's current photo (see the
# comment at the top of that script). NO PAGE LINKS HERE — pages use the hashed
# /_astro/ copies — so these are only ever fetched by the admin panel.
#
# Deliberately NOT immutable, unlike /_astro/: these filenames carry no content
# hash, so a board member re-uploading a photo under the same name reuses the
# URL. A long cache would show them their old picture in the admin panel and
# leave them wondering whether the upload worked. Five minutes is enough to keep
# the list snappy without lying about what was just uploaded.
#
# noindex because they duplicate images already served, better, from /_astro/ —
# there is nothing to gain from search engines indexing both copies.
/images/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

# The admin panel (public/admin/*) is our own first-party HTML/CSS/JS, so its
# policy is as strict as the public site's — no 'unsafe-inline' anywhere, all
# scripts and styles from 'self'. It differs from the global /* policy in
# exactly two ways, both deliberate:
#
#   img-src … blob:  — the photo picker shows a local preview of the file you
#                      just chose, before it is uploaded, via createObjectURL().
#   no analytics     — the beacon and the contact-form origins have no business
#                      on an authenticated page, so they are simply left out.
#
# Everything the panel talks to is same-origin: the API lives at /admin/api/*
# on this very Worker, so connect-src 'self' covers it. It never contacts the
# GitHub API from the browser — the Worker holds the token and does that server
# side (see worker/README.md), which is the whole reason this policy can be
# tight where the old Sveltia one had to allow api.github.com.
#
# Cloudflare COMBINES a repeated header across matching rules (it would
# INTERSECT the two policies), so "! Content-Security-Policy" first drops the
# global /* policy, then we set this admin-only one.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Robots-Tag: noindex
  # The panel reflects live repo state and posts writes; never let anything
  # between here and the browser hold on to a response.
  Cache-Control: no-store
