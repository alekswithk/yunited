# Cloudflare Pages reads this file from the repo root.
# Rules are matched in order and later matches win, so the general rule comes
# first and the more specific paths override it below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # No 'unsafe-inline' anywhere: injected markup cannot run script or restyle
  # the page, which is the whole point of having a policy. Keeping it that way
  # is a build-config invariant, not a habit —
  #   style-src: astro.config.mjs sets build.inlineStylesheets:'never', and no
  #     .astro file carries a style="…" attribute (the classes are in
  #     global.css instead).
  #   script-src: the same config sets vite.build.assetsInlineLimit:0, so every
  #     <script> is emitted as a hashed file under /_astro rather than inlined.
  # The one inline block left is <script type="application/ld+json">, and CSP
  # does not apply to it: a script element whose type is not a JavaScript MIME
  # type is a data block, and HTML's "prepare the script element" returns before
  # it ever reaches the CSP check. Nothing executes, so nothing is blocked.
  #
  # The policy also pins every external origin we allow.
  # static.cloudflareinsights.com is the Cloudflare Web Analytics beacon.
  # formspree.io needs both connect-src (the contact form's fetch submit) and
  # form-action (the no-JS fallback, which posts the form natively).
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Astro fingerprints everything it emits here — the stylesheet, optimized
# images, page scripts — with a content hash in the filename, so a given URL
# never changes meaning. Cache it forever; a new build ships new filenames.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

# Font filenames encode family, weight, style and subset, so they only change
# when the font itself is regenerated. Safe to hold on to.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, immutable

# The CMS admin app (Sveltia SPA) needs a looser policy than the public site: it
# talks to the GitHub API, runs a bundled single-page app, and pulls its icon font
# (Material Symbols) plus two UI fonts as .woff2 files from a CDN. Without the
# font origin allowed, the icon ligatures never resolve and the toolbar renders
# raw text like "cloud_upload".
#
# THE FONT ORIGIN IS NOT A CONSTANT — it belongs to Sveltia, not to us, and it
# has moved once already. Up to @sveltia/cms 0.172 the fonts came from Google
# Fonts (fonts.googleapis.com for the CSS, fonts.gstatic.com for the files); as
# of 0.174 they are Fontsource .woff2 files served from cdn.jsdelivr.net, with no
# stylesheet involved, so style-src no longer needs a font origin at all. Both
# Google origins are now dead and have been removed rather than left to rot.
#
# So do not hand-maintain this: `npm run check:dist` reads the font URLs out of
# the vendored bundle and fails the build if this line does not allow them. If it
# ever complains after a @sveltia/cms bump, the font host moved again — put the
# new origin in font-src and delete the old one.
#
# Scoped to /admin only; the public site keeps its strict, fully self-hosted-font
# CSP. Cloudflare COMBINES a repeated header across matching rules (intersecting
# the two CSPs, which would block the CMS), so "! Content-Security-Policy" first
# drops the global /* policy, then we set this admin-only one.
# If something still fails with a CSP violation in the browser console, add the
# named origin here (see docs/CMS.md).
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.githubusercontent.com https://avatars.githubusercontent.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com https://*.githubusercontent.com https://*.workers.dev; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://github.com
  X-Robots-Tag: noindex
