{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yunited",
  "compatibility_date": "2026-07-11",
  "observability": {
    "enabled": true
  },

  // The admin API. Everything else on this site is a static file; this is the
  // one piece of server-side code, and it lives in the SAME Worker as the site
  // rather than a separate one on its own subdomain. That is deliberate:
  //   * /admin/api/* is same-origin, so the panel needs no CORS and its CSP can
  //     stay connect-src 'self';
  //   * the Cloudflare Access application in front of yunited.ch/admin covers
  //     the API too, because Access matches on path prefix — one policy, one
  //     email allow-list, nothing to keep in sync;
  //   * one `wrangler deploy` (or one Cloudflare build) ships both.
  // See worker/README.md.
  "main": "worker/index.js",

  "assets": {
    "directory": "./dist",
    // Lets the Worker serve a static asset itself (env.ASSETS.fetch). Only
    // reached under `wrangler dev`, where the Worker sees every request; in
    // production `run_worker_first` keeps it off the static path entirely.
    "binding": "ASSETS",
    // Without this, an unknown path returns a bare 404 with an EMPTY body — the
    // styled dist/404.html is built but never served. "404-page" makes Workers
    // serve the nearest 404.html, which is the one at the root.
    "not_found_handling": "404-page",
    // Run the Worker FIRST for these paths only. Every other request — every
    // page, image and stylesheet the public site serves — goes straight to
    // static assets without invoking the Worker at all, exactly as before.
    //
    // Note the shape: /admin itself is a static HTML page and must NOT be
    // listed here, or the Worker would have to serve it.
    "run_worker_first": ["/admin/api/*"]
  },

  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Not secrets. The repo is public, the branch is no surprise, and the two
  // CF_ACCESS_* values are public identifiers — the AUD tag is visible in the
  // Access login URL of anyone who visits /admin. The only secret is the token
  // that writes to the repo, and it is set out-of-band with
  // `wrangler secret put GITHUB_TOKEN` (see worker/README.md).
  "vars": {
    "GITHUB_REPO": "alekswithk/yunited",
    "GITHUB_BRANCH": "main",

    // With these set, the Worker verifies the signed token Cloudflare Access
    // issues on every /admin/api/* request, rather than trusting that Access
    // fronted the route. See worker/access.js for why that distinction matters.
    // Both come from Zero Trust → Access → Applications → the /admin app.
    //
    // NOTE FOR LOCAL DEV: `wrangler dev` gets no Access token, so these make
    // every request 403. Put CF_ACCESS_AUD = "" in your .dev.vars to switch the
    // check off locally — .dev.vars overrides what is here.
    "CF_ACCESS_TEAM_DOMAIN": "silent-recipe-bb34.cloudflareaccess.com",
    "CF_ACCESS_AUD": "284df6702d4bfb7ff822cca77803e9cb845fcea2071e5958f6e80bd1d6958b59"
  },

  // NO workers.dev HOSTNAME. This is a security setting, not a preference.
  //
  // Cloudflare Access is attached to the *hostname* yunited.ch, so it fronts
  // yunited.ch/admin and nothing else. The Worker was also reachable at
  // yunited.maric-aleksandar.workers.dev, serving the identical site with no
  // Access in front of it — which, once this Worker owns /admin/api/*, would
  // have meant an unauthenticated endpoint that commits to the repo.
  //
  // Turning the hostname off removes that door entirely. The JWT verification
  // above independently rejects any request without a valid Access token, so
  // the two together are belt and braces; keep both.
  //
  // It also ends a duplicate of the whole public site being served, and
  // indexable, on a second hostname.
  //
  // yunited.ch is attached as a Custom Domain in the Cloudflare dashboard, not
  // as a `routes` entry here, so the site keeps serving normally.
  "workers_dev": false,
  "preview_urls": false
}
