---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableCopy from "../../components/EditableCopy.astro";
import MemberCard from "../../components/MemberCard.astro";
import { members } from "../../lib/content.js";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.members.title");
const description = t("meta.members.description");

const board = Array.isArray(members) ? members : [];
---

<BaseLayout locale={locale} title={title} description={description} path="/members">
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Naš tim · Наш тим · Our team</p>
      <EditableCopy as="h1" key="members.heroTitle" locale={locale} />
      <EditableCopy as="p" key="members.heroLede" locale={locale} />
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section>
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="members.boardEyebrow" locale={locale} />
      <EditableCopy as="h2" key="members.boardHeading" locale={locale} />
      <div id="member-grid">
        {board.length > 0 ? (
          <div class="member-grid">
            {board.map((member) => <MemberCard member={member} locale={locale} />)}
          </div>
        ) : (
          <EditableCopy as="p" class="empty-note" key="members.boardEmpty" locale={locale} />
        )}
      </div>
    </div>
  </section>

  <section class="section-dark">
    <div class="container">
      <EditableCopy as="h2" key="members.involvedHeading" locale={locale} />
      <EditableCopy as="p" class="section-intro" key="members.involvedBody" locale={locale} />
      <a class="btn btn-gold" href={localizePath("/contact", locale)}>{t("members.involvedCta")}</a>
    </div>
  </section>
</BaseLayout>
