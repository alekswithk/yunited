---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageToc from "../../components/PageToc.astro";
import EditableCopy from "../../components/EditableCopy.astro";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.about.title");
const description = t("meta.about.description");

// Each id must match a <section id> below.
const sections = [
  { id: "mission", key: "toc.mission" },
  { id: "buddy", key: "toc.buddy" },
  { id: "story", key: "toc.story" },
  { id: "values", key: "toc.values" },
];
---

<BaseLayout locale={locale} title={title} description={description} path="/about">
  <PageToc sections={sections} locale={locale} label="toc.aria" />

  <section class="page-hero">
    <div class="container">
      <p class="hero-script">O nama · О нама · About us</p>
      <EditableCopy as="h1" key="about.heroTitle" locale={locale} />
      <EditableCopy as="p" key="about.heroLede" locale={locale} />
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section id="mission">
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="about.missionEyebrow" locale={locale} />
      <EditableCopy as="h2" key="about.missionHeading" locale={locale} />
      <div class="prose-column">
        <EditableCopy as="p" key="about.missionP1" locale={locale} />
        <EditableCopy as="p" key="about.missionP2" locale={locale} />
        <EditableCopy as="p" key="about.missionP3" locale={locale} />
        <EditableCopy as="p" key="about.missionP4" locale={locale} />
      </div>
    </div>
  </section>

  <section id="buddy">
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="about.buddyEyebrow" locale={locale} />
      <EditableCopy as="h2" key="about.buddyHeading" locale={locale} />
      <EditableCopy as="p" class="section-intro" key="about.buddyTeaser" locale={locale} />
      <p class="section-cta">
        <a class="btn btn-gold" href={localizePath("/buddy", locale)}>{t("about.buddyCta")}</a>
      </p>
    </div>
  </section>

  <section id="story" class="section-dark">
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="about.storyEyebrow" locale={locale} />
      <EditableCopy as="h2" key="about.storyHeading" locale={locale} />
      <EditableCopy as="p" class="section-intro" key="about.storyIntro" locale={locale} />
    </div>
  </section>

  <section id="values">
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="about.valuesEyebrow" locale={locale} />
      <EditableCopy as="h2" key="about.valuesHeading" locale={locale} />
      <div class="split-grid">
        <div class="info-panel panel-red">
          <EditableCopy as="h3" key="about.valueCommunityTitle" locale={locale} />
          <EditableCopy as="p" key="about.valueCommunityBody" locale={locale} />
        </div>
        <div class="info-panel">
          <EditableCopy as="h3" key="about.valueCultureTitle" locale={locale} />
          <EditableCopy as="p" key="about.valueCultureBody" locale={locale} />
        </div>
        <div class="info-panel panel-gold">
          <EditableCopy as="h3" key="about.valueCareersTitle" locale={locale} />
          <EditableCopy as="p" key="about.valueCareersBody" locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
