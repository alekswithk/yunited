---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableCopy from "../../components/EditableCopy.astro";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.exchange.title");
const description = t("meta.exchange.description");

// HSG's own incoming-exchange page. German gets HSG's German version; every
// other locale (including English) gets the English one — HSG doesn't
// publish this page in hr/bs/sr, and there is no reason to send those
// readers to a German-only page when English is right there.
const officialInfoUrl = locale === "de"
  ? "https://www.unisg.ch/de/studium/austauschprogramm/incoming-gaststudierende/"
  : "https://www.unisg.ch/en/studying/exchange-programme/incoming-guest-students/";
---

<BaseLayout locale={locale} title={title} description={description} path="/exchange">
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Razmena · Размена · Exchange</p>
      <EditableCopy as="h1" key="exchange.heroTitle" locale={locale} />
      <EditableCopy as="p" key="exchange.heroLede" locale={locale} />
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section>
    <div class="container">
      <div class="split-grid">

        <!-- Audience 1: incoming exchange students -->
        <div class="info-panel panel-red">
          <EditableCopy as="p" class="eyebrow" key="exchange.incomingEyebrow" locale={locale} />
          <EditableCopy as="h3" key="exchange.incomingHeading" locale={locale} />
          <EditableCopy as="p" key="exchange.incomingLede" locale={locale} />
          <ul>
            <li set:html={t("exchange.incomingBuddy")}></li>
            <li set:html={t("exchange.incomingEvents")}></li>
            <li set:html={t("exchange.incomingHome")}></li>
          </ul>
          <p class="section-cta">
            <a class="btn btn-gold" href={officialInfoUrl} target="_blank" rel="noopener">{t("exchange.incomingOfficialCta")}</a>
            <a class="btn btn-red" href={localizePath("/contact", locale)}>{t("exchange.incomingCta")}</a>
          </p>
        </div>

        <!-- Audience 2: outgoing HSG students -->
        <div class="info-panel">
          <EditableCopy as="p" class="eyebrow eyebrow-azure" key="exchange.outgoingEyebrow" locale={locale} />
          <EditableCopy as="h3" key="exchange.outgoingHeading" locale={locale} />
          <EditableCopy as="p" key="exchange.outgoingLede" locale={locale} />
          <ul>
            <EditableCopy as="li" key="exchange.outgoingItem1" locale={locale} />
            <li set:html={t("exchange.outgoingItem2")}></li>
            <li>{t("exchange.outgoingItem3Pre")}<a href={localizePath("/contact", locale)}>{t("exchange.outgoingItem3Link")}</a>{t("exchange.outgoingItem3Post")}</li>
          </ul>
          <p class="section-cta">
            <a class="btn btn-outline" href={localizePath("/contact", locale)}>{t("exchange.outgoingCta")}</a>
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
