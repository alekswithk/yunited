---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePaths } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.contact.title");
const description = t("meta.contact.description");
---

<BaseLayout locale={locale} title={title} description={description} path="/contact">
  <link rel="preconnect" href="https://formspree.io" slot="head" />

  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Kontakt · Контакт · Contact</p>
      <h1>{t("contact.heroTitle")}</h1>
      <p>{t("contact.heroLede")}</p>
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section>
    <div class="container">
      <p class="eyebrow">{t("contact.formEyebrow")}</p>
      <h2>{t("contact.formHeading")}</h2>

      <!--
        The form posts to Formspree, which forwards submissions to the club
        inbox. The action attribute is a real endpoint, so the form still
        works without JavaScript (Formspree renders its own thank-you page);
        the script below upgrades that to an in-page submit so visitors never
        leave the site.
      -->
      <p class="form-success" id="form-success" role="status" tabindex="-1">
        {t("contact.formSuccess")}
      </p>

      <form id="contact-form" class="form-grid" action="https://formspree.io/f/xeeyoryk" method="POST" novalidate
        data-msg-invalid={t("contact.formError")}
        data-msg-fallback={t("contact.formFallback")}
        data-label-send={t("contact.formSend")}
        data-label-sending={t("contact.formSending")}>
        <div>
          <label for="field-name">{t("contact.labelName")}</label>
          <input id="field-name" name="name" type="text" required autocomplete="name">
        </div>
        <div>
          <label for="field-email">{t("contact.labelEmail")}</label>
          <input id="field-email" name="email" type="email" required autocomplete="email"
            placeholder="you@student.unisg.ch">
        </div>
        <div>
          <label for="field-topic">{t("contact.labelTopic")}</label>
          <select id="field-topic" name="topic" required>
            <option value="">{t("contact.topicChoose")}</option>
            <option>{t("contact.topicMembership")}</option>
            <option>{t("contact.topicEvents")}</option>
            <option>{t("contact.topicPartnerships")}</option>
            <option>{t("contact.topicExchange")}</option>
            <option>{t("contact.topicOther")}</option>
          </select>
        </div>
        <div>
          <label for="field-message">{t("contact.labelMessage")}</label>
          <textarea id="field-message" name="message" rows="6" required></textarea>
        </div>

        <!-- Formspree uses this as the subject line of the notification email. -->
        <input type="hidden" name="_subject" value="YUnited website — contact form">
        <!-- Honeypot: real people never see it, bots fill it in and get dropped. -->
        <input class="honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true">

        <!--
          Deliberately empty: role="alert" announces on a CONTENT CHANGE, so a
          paragraph that already holds the error text stays silent when it is
          merely un-hidden. The script writes the message in, which is the
          mutation a screen reader acts on. Without JS this line never appears
          — the form posts natively to Formspree instead, which reports its own
          errors on its own page. The message text itself lives in
          data-msg-invalid on the <form> above, so it stays localized.
        -->
        <p class="form-error" id="form-error" role="alert"></p>
        <div>
          <button class="btn btn-red" type="submit" id="form-submit">{t("contact.formSend")}</button>
        </div>
        <p class="form-note">
          {t("contact.formNote")}
        </p>
      </form>

      <p class="form-alt" set:html={t("contact.plainEmail")}></p>
    </div>
  </section>

  <script>
    // Contact form: client-side validation, then submit to Formspree over
    // fetch so the visitor stays on the page. If this script never runs the
    // form still posts natively to the same endpoint — the only thing lost is
    // the in-page success message.
    //
    // A processed <script>, not is:inline: Astro bundles it to a hashed file
    // under /_astro, which is what lets script-src stay 'self' with no
    // 'unsafe-inline' (PLAN.md §4).
    const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
    const errorLine = document.querySelector<HTMLElement>("#form-error");
    const successLine = document.querySelector<HTMLElement>("#form-success");
    const submitButton = document.querySelector<HTMLButtonElement>("#form-submit");

    if (contactForm && errorLine && successLine && submitButton) {
      // Localized copy comes from data-* attributes on the form, so these
      // strings follow the page's language instead of being hardcoded English
      // here.
      const MSG_INVALID = contactForm.dataset.msgInvalid || "";
      const CONTACT_FALLBACK = contactForm.dataset.msgFallback || "";
      const LABEL_SEND = contactForm.dataset.labelSend || submitButton.textContent || "";
      const LABEL_SENDING = contactForm.dataset.labelSending || "";

      const showError = (text: string) => {
        errorLine.textContent = text;
        errorLine.classList.add("is-visible");
      };

      contactForm.addEventListener("submit", async (submitEvent) => {
        submitEvent.preventDefault();

        const nameField = document.querySelector<HTMLInputElement>("#field-name");
        const emailField = document.querySelector<HTMLInputElement>("#field-email");
        const topicField = document.querySelector<HTMLSelectElement>("#field-topic");
        const messageField = document.querySelector<HTMLTextAreaElement>("#field-message");
        if (!nameField || !emailField || !topicField || !messageField) return;

        const emailLooksValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailField.value.trim());

        // In document order, so "the first thing that's wrong" is also the
        // first one you'd reach by tabbing.
        const checks: [HTMLElement, boolean][] = [
          [nameField, Boolean(nameField.value.trim())],
          [emailField, emailLooksValid],
          [topicField, Boolean(topicField.value)],
          [messageField, Boolean(messageField.value.trim())],
        ];

        for (const [field, ok] of checks) {
          field.setAttribute("aria-invalid", ok ? "false" : "true");
        }

        const firstInvalid = checks.find(([, ok]) => !ok);
        if (firstInvalid) {
          showError(MSG_INVALID);
          // One generic message for the whole form is only usable if it also
          // says WHERE the problem is — otherwise a keyboard or screen-reader
          // visitor has to hunt for it.
          firstInvalid[0].focus();
          return;
        }

        errorLine.classList.remove("is-visible");
        submitButton.disabled = true;
        submitButton.textContent = LABEL_SENDING;

        try {
          const response = await fetch(contactForm.action, {
            method: "POST",
            body: new FormData(contactForm),
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            contactForm.reset();
            contactForm.hidden = true;
            successLine.classList.add("is-visible");
            successLine.focus();
            return;
          }

          const body = await response.json().catch(() => null);
          const detail = body && body.errors && body.errors.length
            ? body.errors.map((error: { message: string }) => error.message).join(" ")
            : null;
          showError(detail || CONTACT_FALLBACK);
        } catch {
          showError(CONTACT_FALLBACK);
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = LABEL_SEND;
        }
      });
    }
  </script>
</BaseLayout>
