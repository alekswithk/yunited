---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.partners.title");
const description = t("meta.partners.description");
---

<BaseLayout locale={locale} title={title} description={description} path="/partners">
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Partneri · Партнери · Partners</p>
      <h1>{t("partners.heroTitle")}</h1>
      <p>{t("partners.heroLede")}</p>
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section>
    <div class="container reveal">
      <p class="eyebrow">{t("partners.whyEyebrow")}</p>
      <h2>{t("partners.whyHeading")}</h2>
      <div class="split-grid">
        <div class="info-panel panel-red">
          <h3>{t("partners.reachTitle")}</h3>
          <p>{t("partners.reachBody")}</p>
        </div>
        <div class="info-panel">
          <h3>{t("partners.visibilityTitle")}</h3>
          <p>{t("partners.visibilityBody")}</p>
        </div>
        <div class="info-panel panel-gold">
          <h3>{t("partners.networkTitle")}</h3>
          <p>{t("partners.networkBody")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark">
    <div class="container reveal">
      <p class="eyebrow eyebrow-azure">{t("partners.ctaEyebrow")}</p>
      <h2>{t("partners.ctaHeading")}</h2>
      <p class="section-intro">{t("partners.ctaBody")}</p>
      <a class="btn btn-gold" href={localizePath("/contact", locale)}>{t("partners.ctaButton")}</a>
    </div>
  </section>
</BaseLayout>
