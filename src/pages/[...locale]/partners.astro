---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableCopy from "../../components/EditableCopy.astro";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";
import { partners } from "../../lib/content.js";
import { resolveImage } from "../../lib/images.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.partners.title");
const description = t("meta.partners.description");
---

<BaseLayout locale={locale} title={title} description={description} path="/partners">
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Partneri · Партнери · Partners</p>
      <EditableCopy as="h1" key="partners.heroTitle" locale={locale} />
      <EditableCopy as="p" key="partners.heroLede" locale={locale} />
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  {partners.length > 0 && (
    <section>
      <div class="container">
        <EditableCopy as="p" class="eyebrow" key="partners.currentEyebrow" locale={locale} />
        <EditableCopy as="h2" key="partners.currentHeading" locale={locale} />
        <ul class="card-grid partner-grid">
          {partners.map((partner) => {
            const logo = partner.logo ? resolveImage(partner.logo) : undefined;
            const content = (
              <>
                <div class="logo-area">
                  {logo && (
                    <Image src={logo} alt="" width={340} densities={[1, 2]} loading="lazy" />
                  )}
                </div>
                <p class="partner-name">{partner.name}</p>
              </>
            );
            return (
              <li class="partner-card">
                <a class="edit-affordance" hidden href={`/admin#partners/${partner.slug}.json`}>Edit</a>
                {partner.url ? (
                  <a class="partner-link" href={partner.url} target="_blank" rel="noopener noreferrer">{content}</a>
                ) : (
                  content
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section>
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="partners.whyEyebrow" locale={locale} />
      <EditableCopy as="h2" key="partners.whyHeading" locale={locale} />
      <div class="split-grid">
        <div class="info-panel panel-red">
          <EditableCopy as="h3" key="partners.reachTitle" locale={locale} />
          <EditableCopy as="p" key="partners.reachBody" locale={locale} />
        </div>
        <div class="info-panel">
          <EditableCopy as="h3" key="partners.visibilityTitle" locale={locale} />
          <EditableCopy as="p" key="partners.visibilityBody" locale={locale} />
        </div>
        <div class="info-panel panel-gold">
          <EditableCopy as="h3" key="partners.networkTitle" locale={locale} />
          <EditableCopy as="p" key="partners.networkBody" locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark">
    <div class="container">
      <EditableCopy as="p" class="eyebrow eyebrow-azure" key="partners.ctaEyebrow" locale={locale} />
      <EditableCopy as="h2" key="partners.ctaHeading" locale={locale} />
      <EditableCopy as="p" class="section-intro" key="partners.ctaBody" locale={locale} />
      <a class="btn btn-gold" href={localizePath("/contact", locale)}>{t("partners.ctaButton")}</a>
    </div>
  </section>
</BaseLayout>
