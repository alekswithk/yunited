---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableCopy from "../../components/EditableCopy.astro";
import { localePaths, localizePath } from "../../i18n/config.js";
import { useTranslations } from "../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

const title = t("meta.join.title");
const description = t("meta.join.description");
const uniclubsUrl = "https://uniclubs.ch/hsg/clubs/yunited";
---

<BaseLayout locale={locale} title={title} description={description} path="/join">
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Pridruži se · Придружи се · Join us</p>
      <EditableCopy as="h1" key="join.heroTitle" locale={locale} />
      <EditableCopy as="p" key="join.heroLede" locale={locale} />
      <div class="hero-actions join-hero-actions">
        <a class="btn btn-gold join-hero-cta" href={uniclubsUrl} target="_blank" rel="noopener">
          {t("join.cta")}
        </a>
      </div>
    </div>
  </section>

  <div class="motif-divider" role="presentation"></div>

  <section>
    <div class="container">
      <EditableCopy as="p" class="eyebrow" key="join.getEyebrow" locale={locale} />
      <EditableCopy as="h2" key="join.getHeading" locale={locale} />
      <div class="split-grid split-narrow">
        <div class="info-panel panel-red">
          <EditableCopy as="h3" key="join.semesterTitle" locale={locale} />
          <p set:html={t("join.semesterBody")}></p>
        </div>
        <div class="info-panel panel-gold">
          <EditableCopy as="h3" key="join.freeTitle" locale={locale} />
          <p set:html={t("join.freeBody")}></p>
        </div>
      </div>
      <p class="section-cta-lg join-cta">
        <a class="btn btn-gold" href={uniclubsUrl} target="_blank" rel="noopener">
          {t("join.cta")}
        </a>
      </p>
      <p class="form-note">
        {t("join.note")}
      </p>
    </div>
  </section>

  <section class="section-dark">
    <div class="container">
      <EditableCopy as="h2" key="join.questionsHeading" locale={locale} />
      <EditableCopy as="p" class="section-intro" key="join.questionsBody" locale={locale} />
      <a class="btn btn-gold" href={localizePath("/contact", locale)}>{t("join.questionsCta")}</a>
    </div>
  </section>
</BaseLayout>
