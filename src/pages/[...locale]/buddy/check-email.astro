---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { localePaths, localizePath } from "../../../i18n/config.js";
import { useTranslations } from "../../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

// Where /buddy/api/signup redirects a no-JavaScript submission. The JS path
// shows the same message inline without leaving the page.
const title = t("meta.buddy.title");
const description = t("meta.buddyPair.description");
---

<BaseLayout locale={locale} title={title} description={description} path="/buddy/check-email" noindex>
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Kumstvo · Кумство · Buddy system</p>
      <h1>{t("buddy.checkEmailTitle")}</h1>
      <p>{t("buddy.checkEmailBody")}</p>
      <p class="section-cta">
        <a class="btn btn-gold" href={localizePath("/buddy", locale)}>{t("buddy.confirmedBack")}</a>
      </p>
    </div>
  </section>
</BaseLayout>
