---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { localePaths, localizePath } from "../../../i18n/config.js";
import { useTranslations } from "../../../i18n/utils.js";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
const t = useTranslations(locale);

// Where the one-click unsubscribe link in every buddy email lands.
const title = t("meta.buddy.title");
const description = t("meta.buddyPair.description");
---

<BaseLayout locale={locale} title={title} description={description} path="/buddy/removed" noindex>
  <section class="page-hero">
    <div class="container">
      <p class="hero-script">Kumstvo · Кумство · Buddy system</p>
      <h1>{t("buddy.removedTitle")}</h1>
      <p>{t("buddy.removedBody")}</p>
      <p class="section-cta">
        <a class="btn btn-gold" href={localizePath("/buddy", locale)}>{t("buddy.confirmedBack")}</a>
      </p>
    </div>
  </section>
</BaseLayout>
