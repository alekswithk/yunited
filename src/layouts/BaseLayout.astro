---
// The single source of truth for every page's <head> and page chrome.
// Props: title, description, path (route, for canonical + active nav),
// and noindex (for 404). A named "head" slot lets a page inject extra
// tags such as JSON-LD.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, getLocale, localizePath, publishedLocales } from "../i18n/config.js";
import "../styles/global.css";

const {
  title,
  description,
  path = "/",
  locale = defaultLocale,
  noindex = false,
} = Astro.props;

const loc = getLocale(locale);
const canonical = new URL(localizePath(path, loc.code), Astro.site).href;
const ogImage = new URL("/assets/og-image.png", Astro.site).href;

// Only finished translations are advertised to crawlers. An in-progress locale
// still renders (so it can be reviewed at its real URL) but is kept out of the
// alternates and marked noindex, so a half-translated page is never indexed.
const alternates = publishedLocales();
const hideFromIndex = noindex || !loc.complete;
// `noindex` also means "this page is not part of the localized route set", and
// only 404.astro passes it: that page lives outside src/pages/[...locale]/, so
// it has no per-locale twin and the usual hreflang set pointed at /de/404 — a
// URL that is never built. Draft locales keep their alternates; they do have
// real twins, they are just not finished yet.
const showAlternates = alternates.length > 1 && !noindex;
---

<!DOCTYPE html>
<html lang={loc.htmlLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {hideFromIndex && <meta name="robots" content="noindex">}

  <link rel="canonical" href={canonical}>

  {showAlternates && alternates.map((l) => (
    <link rel="alternate" hreflang={l.code} href={new URL(localizePath(path, l.code), Astro.site).href}>
  ))}
  {showAlternates && (
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, defaultLocale), Astro.site).href}>
  )}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="YUnited">
  <meta property="og:locale" content={loc.ogLocale}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="The YUnited wordmark on a cream background with a kilim diamond motif">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="icon" type="image/svg+xml" href="/assets/yunited-favicon.svg">
  <link rel="alternate icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#f4ecdd">
  <link rel="preload" href="/assets/fonts/fraunces-400-900-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/newsreader-400-600-normal-latin.woff2" as="font" type="font/woff2" crossorigin>

  <slot name="head" />
</head>
<body>

  <Header path={path} switchPath={noindex ? "/" : path} locale={loc.code} />

  <main>
    <slot />
  </main>

  <div class="motif-divider" role="presentation"></div>

  <Footer locale={loc.code} />

  <script>
    // Shared behaviours from the old main.js: mobile menu toggle, the
    // language switcher's outside-click, and the table-of-contents scroll spy.
    // The footer year is rendered at build time; reveal-on-scroll is gone (see
    // "Reveal-on-scroll: removed" in global.css).

    // --- Mobile menu toggle ---
    const navToggleButton = document.querySelector(".nav-toggle");
    const mainNav = document.querySelector(".main-nav");

    if (navToggleButton && mainNav) {
      navToggleButton.addEventListener("click", () => {
        const isOpen = mainNav.classList.toggle("is-open");
        navToggleButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });
    }

    // --- Language switcher: close on outside click and on Escape ---
    // <details> handles opening, focus and keyboard activation itself; these are
    // the only two behaviours it doesn't provide. With JS off the menu still
    // opens and closes on click, which is why it's a disclosure and not a
    // scripted dropdown.
    const langSwitch = document.querySelector<HTMLDetailsElement>(".lang-switch");

    if (langSwitch) {
      document.addEventListener("click", (event) => {
        const target = event.target as Node | null;
        if (langSwitch.open && target && !langSwitch.contains(target)) {
          langSwitch.open = false;
        }
      });

      langSwitch.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && langSwitch.open) {
          langSwitch.open = false;
          langSwitch.querySelector("summary")?.focus();
        }
      });
    }

    // --- Table-of-contents scroll spy ---
    // Marks the entry for the section you are reading. Without JS the links
    // still work as plain anchors; they just don't highlight. aria-current is
    // the single source of truth here, so what is announced and what is styled
    // can never drift apart.
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");

    if (tocLinks.length > 0) {
      const entries: { link: HTMLAnchorElement; section: HTMLElement }[] = [];

      tocLinks.forEach((link) => {
        const id = link.dataset.tocLink;
        if (!id) return;
        const section = document.getElementById(id);
        if (!section) return; // a TOC entry naming a section that isn't here
        entries.push({ link, section });
      });

      // The reading line: a section becomes current once its top has passed this
      // far down the viewport, and stays current until the next one does. The
      // page's sections are contiguous, so this is the same as "the section the
      // line is currently inside".
      //
      // This replaced an IntersectionObserver watching a 10%-tall band pinned at
      // 20% of the viewport, which had two faults, both seen in Chrome on
      // /hr/about. It fired late — 20% down is high enough that a full-width
      // dark section (#story) had filled almost the whole screen before its
      // entry lit — and the band could not be reached at all by a section too
      // close to the end of the document: the last entry stays reachable only
      // while `document height - last section top > (1 - line) * viewport`, so
      // at 0.2 "Vrijednosti" went unlit at every viewport taller than ~1154px,
      // with "Priča" left highlighted over a screen full of Values. 0.4 both
      // moves the switch to where the eye already is and widens that margin;
      // `atBottom` closes the case outright.
      const READING_LINE = 0.4;

      // The rail also passes over the dark sections (.hero / .page-hero /
      // .section-dark, all --color-ink) as they scroll past, and its dark inks
      // vanish against them. Each entry is told when ink is behind IT and flips
      // to the paper palette.
      //
      // Per entry, not per rail: the rail is ~120px tall, so at a section
      // boundary a single toggle would always leave one end of it unreadable.
      //
      // Side-agnostic on purpose — it measures where each entry actually is, so
      // it kept working unchanged when the rail moved to the right gutter.
      const darkSurfaces = Array.from(
        document.querySelectorAll(".hero, .page-hero, .section-dark, .site-footer")
      );

      // Both jobs measure on scroll, on one rAF-throttled pass. Neither can be
      // precomputed: the rail is position:sticky, so it MOVES within the
      // viewport — it scrolls in, holds, then scrolls away with the content.
      let queued = 0;

      const sync = () => {
        queued = 0;
        // All reads first, then all writes — never interleaved, so this cannot
        // thrash layout while scrolling.
        const line = window.innerHeight * READING_LINE;
        const sectionTops = entries.map(({ section }) => section.getBoundingClientRect().top);
        const darkBoxes = darkSurfaces.map((el) => el.getBoundingClientRect());
        const linkBoxes = entries.map(({ link }) => link.getBoundingClientRect());
        // The last section is only reachable by the line if the document
        // continues far enough past its top. When it doesn't, hitting the end of
        // the page is the answer: you cannot be reading anything else.
        const atBottom =
          window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

        // Sections are in document order, so the LAST one whose top has crossed
        // the line is the one being read; before the first has crossed it —
        // while the hero is still filling the screen — nothing is current.
        let current = atBottom ? entries.length - 1 : -1;
        if (!atBottom) sectionTops.forEach((top, i) => { if (top <= line) current = i; });

        entries.forEach(({ link }, i) => {
          if (i === current) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");

          const box = linkBoxes[i];
          if (box.height === 0) return; // rail hidden (below 1480px)
          // Test the entry's midpoint: it flips once it is more than half over
          // ink, which reads as deliberate rather than flickering at the exact
          // moment an edge touches.
          const middle = (box.top + box.bottom) / 2;
          const onDark = darkBoxes.some((d) => d.top < middle && d.bottom > middle);
          link.classList.toggle("is-on-dark", onDark);
        });
      };

      const requestSync = () => {
        if (!queued) queued = requestAnimationFrame(sync);
      };

      sync();
      window.addEventListener("scroll", requestSync, { passive: true });
      window.addEventListener("resize", requestSync);
      // The rail is set in Space Mono with font-display: swap, so its height
      // changes when the real font lands — usually after this first runs.
      document.fonts?.ready.then(sync);
    }
  </script>
</body>
</html>
